<Window x:Class="Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Editor.Controls"
        
        Title="My Editor"
        Width="1920"
        Height="1080"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#1E1E1E">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="26"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#3C3C3C"
        BorderThickness="1"
        Background="#1E1E1E">

        <Grid Name="Grid0">
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:TitleBar Grid.Row="0" />

            <StackPanel Grid.Row="1" Background="#252526">

            </StackPanel>

            <Grid Grid.Row="2" Name="Grid1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <TextBlock FontSize="55" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           TextWrapping="Wrap">
                    Left
                </TextBlock>

                <GridSplitter Background="LightSlateGray" 
                              Grid.Column="1" 
                              Width="2" 
                              HorizontalAlignment="Stretch">
                </GridSplitter>


                <Grid Grid.Column="2" Name="Grid2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0" 
                               FontSize="55" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               TextWrapping="Wrap">
                        Viewport
                    </TextBlock>

                    <GridSplitter Background="LightSlateGray" 
                                  Grid.Row="1" 
                                  Height="2" 
                                  HorizontalAlignment="Stretch">
                    </GridSplitter>


                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Logger"
                                   Margin="5, 2"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   FontStyle="Italic"
                                   Foreground="MediumAquamarine"
                        />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Logs}"
                                  Style="{StaticResource DarkLoggerDataGrid}"
                                  Margin="0,5">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time"
                                                    Binding="{Binding Time}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="Origin"
                                                    Binding="{Binding Origin}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="File"
                                                    Binding="{Binding File}"
                                                    Width="140"/>

                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding Description}"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Foreground" Value="#DCDCDC"/>
                                            <Setter Property="Padding" Value="6,2"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <GridSplitter Background="LightSlateGray" 
                              Grid.Column="3" 
                              Width="2" 
                              HorizontalAlignment="Stretch">
                </GridSplitter>

                <TextBlock Grid.Column="4" 
                           FontSize="55" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           TextWrapping="Wrap">
                    Right
                </TextBlock>

            </Grid>
        </Grid>
    </Border>
</Window>